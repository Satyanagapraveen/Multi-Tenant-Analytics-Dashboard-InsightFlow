DJANGO_SECRET_KEY=django-insecure-super-secret-key-change-me
POSTGRES_DB="your_db_name"
POSTGRES_USER="your_postgres_username"
POSTGRES_PASSWORD="your_postgres_password"
DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
GOOGLE_OAUTH2_CLIENT_ID=Your-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=YOUR_SECRET_KEY
GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:5173